# ============================================================
# MediCore OS — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.

# PostgreSQL Database URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/medicore

# Groq Cloud API Key (get one at https://console.groq.com)
GROQ_API_KEY=gsk_your_key_here

# JWT Secret (change this to a random string in production!)
JWT_SECRET=medicore-dev-secret-change-in-production

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
